# Copy to .env and fill in. Both keys are free (no card):
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional overrides
# SHIFA_FAST_MODEL=openai/gpt-oss-20b
# SHIFA_SMART_MODEL=openai/gpt-oss-120b
# SHIFA_GEMINI_MODEL=gemini-3.6-flash
# SHIFA_USE_OLLAMA=false
# SHIFA_OLLAMA_MODEL=qwen2.5:3b
# SHIFA_TODAY=2026-11-02   # pin "today" (evals do this for determinism)

# Patient messages (confirmations + reminders). "simulate" = shown on the dashboard only, nothing is sent.
# SHIFA_MESSAGING_PROVIDER=simulate
# SHIFA_WHATSAPP_TOKEN=
# SHIFA_WHATSAPP_PHONE_NUMBER_ID=
# SHIFA_WHATSAPP_MODE=text            # text = inside the 24 h window (testing) | template = approved template
# SHIFA_WHATSAPP_TEMPLATE_NAME=appointment_update
# SHIFA_WHATSAPP_TEMPLATE_LANG=en
